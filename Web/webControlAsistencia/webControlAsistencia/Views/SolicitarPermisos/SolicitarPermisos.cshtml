@model webControlAsistencia.Models.ClassSolicitarPermisos

@{
    ViewData["Title"] = "SolicitarPermisos";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/SolicitarPermisoEstilo.css" />
    <link rel="stylesheet" href="~/css/DetallesTareaEstilo.css" />
    <link rel="stylesheet" href="~/css/ActividadesAsignadasEstilo.css" />
</head>
<br />
<br />

<div class="permiso-layout">
    <form asp-action="CrearPermiso" class="permiso-form" asp-controller="SolicitarPermisos" method="get">
        <div class="row">

            <div class="col-md-7">
                <div class="detalle-wrapper">
                    <div class="detalle">
                        <h4 class="detalle-title">Solicitar Permisos</h4>
                        <hr class="detalle-hr" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <input asp-for="IdPermiso" class="form-control" hidden />

                        <div class="form-group mb-3">
                            <label asp-for="TipoPermiso" class="control-label">Tipo de permiso: </label>
                            <select asp-for="TipoPermiso" class="form-select">
                                <option value="">Seleccione un tipo de permiso</option>
                                <option value="HorasExtra">Horas extra</option>
                                <option value="Vacaciones">Vacaciones</option>
                                <option value="DiaLibre">Solicitud día libre</option>
                                <option value="SalidaAnticipada">Salida anticipada</option>
                            </select>
                            <span asp-validation-for="TipoPermiso" class="text-danger"></span>
                        </div>

                        @* <div class="form-group mb-3">
                        <label asp-for="Asunto" class="control-label">Asunto:</label>
                        <input asp-for="Asunto" class="form-control" />
                        <span asp-validation-for="Asunto" class="text-danger"></span>
                        </div> *@

                        <div class="form-group mb-3">
                            <label asp-for="Descripcion" class="control-label">Descripción:</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="5" style="height:100%"></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="FechaInicio" class="control-label">Fecha y hora de inicio:</label>
                            <input asp-for="FechaInicio" id="fechaInicio" name="fechaInicio" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaInicio" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="FechaFin" class="control-label">Fecha y hora fin:</label>
                            <input asp-for="FechaFin" id="fechaFin" name="fechaFin" class="form-control" type="datetime-local" />
                            <span asp-validation-for="FechaFin" class="text-danger"></span>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger mt-3">@ViewBag.Error</div>
                        }

                        @* <div class="actions">
                        <input type="submit" value="Enviar Solicitud" class="btn-primar" />
                        </div> *@
                        <hr class="detalle-hr" />
                        <div class="row">
                            <div class="col-12">
                                <div class="detalle-actions-centered">
                                    <input type="submit" value="Crear solicitud" class="btn btn-primary" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="tabla-wrapper">
                    <h4 class="detalle-title">Historial de permisos</h4>
                    <hr class="detalle-hr" />

                    <form asp-action="SolicitarPermisos" asp-controller="SolicitarPermisos" method="get" id="formFiltro">
                        <div class="toolbar-left">
                            <div class="toolbar-left">
                                <label class="lbl">Filtro:</label>
                                <select name="filtro" id="filtro" class="form-select">
                                    <option value="Todos">Sin filtro de motivo</option>
                                    <option value="HorasExtra">HorasExtra</option>
                                    <option value="Vacaciones">Vacaciones</option>
                                    <option value="DiaLibre">Dia libre</option>
                                    <option value="SalidaAnticipada">Salida anticipada</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>

                            <div class="toolbar-left">
                                <label class="lbl">Fecha inicio:</label>
                                <input type="date" id="fechaInicioP" name="fechaInicioP" class="form-control" />

                                <label class="lbl">Fecha fin:</label>
                                <input type="date" id="fechaFinP" name="fechaFinP" class="form-control" />

                                <div class="detalle-actions-centered">
                                    <button type="submit" class="btn btn-primary">Aplicar filtro</button>
                                </div>
                            </div>
                        </div>
                    </form>

                    <div class="toolbar-left">
                        <label class="lbl">Buscar:</label>
                        <div class="searchwrap">
                            <input id="search" type="text" class="search" placeholder="Buscar..." />
                        </div>
                    </div>
                    <br />

                    @* <table class="table table-striped table-hover table-sm"> *@
                    <div class="table-responsive">
                        <table class="table table-striped table-hover table-sm">
                            <thead class="thead-dark">
                                <tr>
                                    <th hidden>IdPermisos</th>
                                    <th hidden>IdColaborador</th>
                                    <th>Motivo</th>
                                    @* <th>Asunto</th> *@
                                    @* <th>Descripción</th> *@
                                    <th>Colaborador</th>
                                    <th>Correo</th>
                                    <th>Fecha Solicitud</th>
                                    <th>Fecha Inicio</th>
                                    <th>Fecha Fin</th>
                                    <th>Estado</th>
                                    @if (ViewBag.Validar != null && ViewBag.Validar == "1")
                                    {
                                        <th>Acción</th>
                                    }
                                </tr>
                            </thead>
                            <tbody id="table-body">
                                @if (Model.ListPermiso != null && Model.ListPermiso.Any())
                                {
                                    foreach (var item in Model.ListPermiso)
                                    {
                                        <tr>
                                            <td hidden>@item.IdPermiso</td>
                                            <td hidden>@item.IdColaborador</td>
                                            <td>@item.Motivo</td>
                                            <td>@item.Nombre</td>
                                            <td>@item.Correo</td>
                                            @* <td>@item.Asunto</td> *@
                                            <td hidden>@item.Descripcion</td>
                                            <td>@item.FechaSolicitud</td>
                                            <td>@item.FechaInicio</td>
                                            <td>@item.FechaFin</td>
                                            <td>@item.Estado</td>
                                            @if (ViewBag.Validar != null && ViewBag.Validar == "1")
                                            {
                                                <td class="acciones">
                                                    <input type="button" value="Detalles" class="btn-pill"
                                                           onclick="location.href='@Url.Action("DetallesPermisos","SolicitarPermisos", new { idPermiso = item.IdPermiso, idColaborador = item.IdColaborador })'">

                                                    @* <input type="button" value="Eliminar" class="btn-pill"
                                                           onclick="confirmarEliminacion('@Url.Action("EliminarAsignacionTarea","DetalleTarea", new { id = item.IdPermiso, idColaborador = item.IdColaborador })')"> *@
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="nodata">No hay datos para mostrar</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
       
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // FILTRO DE BÚSQUEDA EN TIEMPO REAL
            $("#search").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#table-body tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // VALIDACIÓN DE FECHAS
            $("#formFiltro").on("submit", function (e) {
                var inicio = $("#fechaInicio").val();
                var fin = $("#fechaFin").val();

                if (inicio && fin && new Date(inicio) > new Date(fin)) {
                    alert("La fecha de inicio no puede ser mayor que la fecha fin.");
                    e.preventDefault();
                    return false;
                }
            });
        });

        function confirmarEliminacion(url) {
            Swal.fire({
                title: "¿Desea eliminar este permiso?",
                text: "Esta acción no se puede deshacer.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#3085d6",
                confirmButtonText: "Sí, eliminar",
                cancelButtonText: "Cancelar"
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = url;
                }
            });
        }
    </script>
}

