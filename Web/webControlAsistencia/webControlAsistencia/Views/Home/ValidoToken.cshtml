@model webControlAsistencia.Models.ClassValidoToken

@{
    ViewData["Title"] = "Validar Token";
}

@{
    Layout = null;
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Validar Token</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/OlvidoContraEstilo.css" />
    <link rel="stylesheet" href="~/css/ActividadesAsignadasEstilo.css" />

</head>
<br />
<br />
<body>
<form id="validarTokenForm" asp-action="ValidoToken" asp-controller="Home" method="get">
    <div class="row">
        <div class="col-md-8">
            <div class="detalle-wrapper">
                <div class="detalle">
                    <h4 class="detalle-title">Validar Token</h4>
                    <p>
                        <h6 class="detalle-title" style="color:red" id="mensaje-token">
                            Consulte su correo e ingrese el **Token** y su **Nueva Contraseña**.
                        </h6>
                    </p>
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger mt-3" id="server-error">@ViewBag.Error</div>
                    }
                    <hr class="detalle-hr" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                   
                    <div class="form-group mb-3">
                        <label asp-for="Token" class="control-label"></label>
                        <input asp-for="Token" class="form-control" />
                        <span asp-validation-for="Token" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="NuevaContraseña" class="control-label"></label>
                        <input asp-for="NuevaContraseña" class="form-control" type="password" id="NuevaContraseña" />
                        <span id="nuevaContrasenaError" class="text-danger"></span>
                        <span asp-validation-for="NuevaContraseña" class="text-danger"></span>
                    </div>

                    <hr class="detalle-hr" />
                    <div class="row">
                        <div class="col-12">
                            <div class="detalle-actions-centered">
                                <input type="submit" value="Actualizar contraseña" class="btn btn-primary" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

</body> 


<script src="~/lib/jquery/dist/jquery.min.js"></script> 


<script>
    $(document).ready(function () {
        var $passwordInput = $('#NuevaContraseña');
        var $errorSpan = $('#nuevaContrasenaError');
        var $form = $('#validarTokenForm');

        // 1. Función de Validación Central
        function validarNuevaContrasena() {
            var password = $passwordInput.val();
            var isValid = true;
            
            // Usaremos una lista para mostrar todos los requisitos faltantes.
            var errorList = $('<ul>').addClass('list-unstyled mt-2');
            $errorSpan.html(''); // Limpiar errores anteriores
            
            // **Política de Contraseña**

            // a. Longitud mínima de 8
            if (password.length < 8) {
                errorList.append($('<li>').text('• Al menos 8 caracteres.'));
                isValid = false;
            }
            
            // b. Al menos una mayúscula ([A-Z])
            if (!/[A-Z]/.test(password)) {
                errorList.append($('<li>').text('• Al menos una letra mayúscula.'));
                isValid = false;
            }
            
            // c. Al menos una minúscula ([a-z])
            if (!/[a-z]/.test(password)) {
                errorList.append($('<li>').text('• Al menos una letra minúscula.'));
                isValid = false;
            }
            
            // d. Al menos un número ([0-9])
            if (!/[0-9]/.test(password)) {
                errorList.append($('<li>').text('• Al menos un número.'));
                isValid = false;
            }
            
            // e. Al menos un carácter especial ([^A-Za-z0-9])
            if (!/[^A-Za-z0-9]/.test(password)) {
                errorList.append($('<li>').text('• Al menos un carácter especial (ej: @@, #, $).'));
                isValid = false;
            }
            
            // f. Sin espacios en blanco
            if (/\s/.test(password)) {
                errorList.append($('<li>').text('• No debe contener espacios en blanco.'));
                isValid = false;
            }
            
            if (!isValid) {
                // Muestra el mensaje de error
                $errorSpan.append($('<h6>').text('La nueva contraseña no cumple la política. Requisitos:').css('color', 'red'));
                $errorSpan.append(errorList);
            }

            // Devuelve el estado de validación
            return isValid;
        }

        // 2. Conectar la validación a los eventos en tiempo real
        
        $passwordInput.on('keyup', validarNuevaContrasena);
        $passwordInput.on('blur', validarNuevaContrasena);
        
        // 3. Modificar la validación al enviar el formulario (submit)
        $form.submit(function (e) {
            if (!validarNuevaContrasena()) {
                e.preventDefault(); 
                e.stopPropagation();
            }
        });
    });
</script>






