@model webControlAsistencia.Models.ClassActividadesAsignadasViewModel

@{
    ViewData["Title"] = "ActividadesAsignadas";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ActividadesAsignadas</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ActividadesAsignadasEstilo.css" />
</head>

<br />
<br />

<h1>ActividadesAsignadas</h1>

<!-- FORMULARIO DE FILTRO -->
<form asp-action="ActividadesAsignadas" asp-controller="ActividadesAsignadas" method="get" id="formFiltro">
    <div class="toolbar">
        <div class="toolbar-left">
            <label class="lbl">Filtro:</label>
            <select name="filtro" id="filtro" class="cbx-filtro form-select">
                <!--<option value="Todos">Seleccione un Filtro</option>-->
                <option value="Todos">Todos</option>
                <option value="Completadas">Completadas</option>
                <option value="Pendientes">Pendientes</option>
            </select>
        </div>

        <div class="toolbar-center">
            <label class="lbl">Fecha inicio:</label>
            <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" />

            <label class="lbl">Fecha fin:</label>
            <input type="date" id="fechaFin" name="fechaFin" class="form-control" />

            <button type="submit" class="btn btn-primary mt-2">Aplicar filtro</button>
        </div>

        
    </div>
</form>

<div class="toolbar-right">
    <label class="lbl">Buscar:</label>
    <div class="searchwrap">
        <input id="search" type="text" class="search" placeholder="Buscar..." />
    </div>
</div>

<br />

<div class="toolbar-center text-center">
    <a asp-action="CrearTarea" asp-controller="CrearTarea" class="btn-crear">Crear actividad</a>
</div>

<table class="grid mt-3">
    <thead>
        <tr>
            <!--Tareas-->
            <th hidden>Id</th>
            <th>Tarea</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Estado Tarea</th>
            <th>Fecha inicio</th>
            <th>Fecha Fin</th>
            <!--Asignacion Tareas-->
            <th hidden>IdAsignacion</th>
            <th>Fecha Asignacion</th>
            <th>Estado Asignacion</th>
            <th hidden>IdColaborador</th>
            <th>Nombre Colaborador</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody id="table-body">
        @if (Model.listTareas != null && Model.listTareas.Any())
        {
            foreach (var item in Model.listTareas)
            {
                <tr>
                    <td hidden>@item.Id</td>
                    <td>@item.Tarea</td>
                    <td>@item.Nombre</td>
                    <td>@item.Descripcion</td>
                    <td>@item.EstadoTarea</td>
                    <td>@item.FechaInicio</td>
                    <td>@item.FechaFin</td>
                    <td hidden>@item.IdAsignacion</td>
                    <td>@item.FechaAsignacion</td>
                    <td>@item.EstadoAsigancion</td>
                    <td hidden>@item.IdColaborador</td>
                    <td>@item.NombreColaborador @item.Apellido</td>
                    <td class="acciones">
                        <input type="button" value="Detalles" class="btn-pill"
                               onclick="location.href='@Url.Action("DetalleTarea","DetalleTarea", new { id = item.Id })'">
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" class="nodata">No hay datos para mostrar</td></tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function () {
            // FILTRO DE BÚSQUEDA EN TIEMPO REAL
            $("#search").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#table-body tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // VALIDACIÓN DE FECHAS
            $("#formFiltro").on("submit", function (e) {
                var inicio = $("#fechaInicio").val();
                var fin = $("#fechaFin").val();

                if (inicio && fin && new Date(inicio) > new Date(fin)) {
                    alert("La fecha de inicio no puede ser mayor que la fecha fin.");
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}


