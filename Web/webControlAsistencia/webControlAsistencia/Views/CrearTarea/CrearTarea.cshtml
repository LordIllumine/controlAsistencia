@model webControlAsistencia.Models.ClassCrearTarea

@{
    ViewData["Title"] = "CrearTarea";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/CrearTareaEstilo.css" />
</head>

<br />
<br />

<h1>Ingresar actividad nueva</h1>

@if (ViewBag.Message != null)
{
    <div class="alert">@ViewBag.Message</div>
}

<div class="crear-wrapper">
    <form asp-action="CrearTarea" class="crear-form" asp-controller="CrearTarea" method="get" id="formCrear">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="field">
      <label asp-for="Tarea" class="label">Tarea:</label>
            <input asp-for="Tarea" class="input" required />
      <span asp-validation-for="Tarea" class="text-danger"></span>
    </div>

    <div class="field">
      <label asp-for="Descripcion" class="label">Descripción:</label>
      <input asp-for="Descripcion" class="input" />
      <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="field">
      <label asp-for="FechaInicio" class="label">Fecha y hora de inicio:</label>
            <input asp-for="FechaInicio" class="input" id="fechaInicio" name="fechaInicio" required/>
      <span asp-validation-for="FechaInicio" class="text-danger"></span>
    </div>

    <div class="field">
      <label asp-for="FechaFin" class="label">Fecha y hora fin:</label>
            <input asp-for="FechaFin" class="input" id="fechaFin" name="fechaFin" required />
      <span asp-validation-for="FechaFin" class="text-danger"></span>
    </div>

    <div class="acciones">
      <input type="submit" value="Guardar tarea" class="btn-primar" />
    </div>
  </form>
</div>

<script>
    $(document).ready(function () {

        // VALIDACIÓN DE FECHAS
        $("#formCrear").on("submit", function (e) {
            var inicio = $("#fechaInicio").val();
            var fin = $("#fechaFin").val();

            if (inicio && fin && new Date(inicio) > new Date(fin)) {
                alert("La fecha de inicio no puede ser mayor que la fecha fin.");
                e.preventDefault();
                return false;
            }
        });
    });
</script>

