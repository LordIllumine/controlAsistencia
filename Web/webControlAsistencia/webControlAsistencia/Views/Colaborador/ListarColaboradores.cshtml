@model IEnumerable<webControlAsistencia.Models.ClassColaborador>

@{
    ViewData["Title"] = "ListarColaboradores";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/ListarColaboradorEstilo.css"/>
    <link rel="stylesheet" href="~/css/ActividadesAsignadasEstilo.css" />
</head>
<br />
<br />

<div class="permiso-layout">
    <form asp-action="detalle" class="" asp-controller="" method="get">
        <div class="row">

            <div class="col-md-7">
                <div class="detalle-wrapper">
                    <div class="detalle">
                        <h4 class="detalle-title">Información del perfil</h4>
                        <hr class="detalle-hr" />
                        <br />
                        <div class="toolbar-left">
                            <label class="lbl">Buscar:</label>
                            <div class="searchwrap">
                                <input id="search" type="text" class="search" placeholder="Buscar..." />
                            </div>
                        </div>
                        <br />
                        @if (ViewBag.Validar == "1")
                        {
                            <div class="toolbar-center text-center">
                                <a asp-action="CrearColaborador" asp-controller="Colaborador" class="btn-crear">Crear colaborador</a>
                            </div>
                        }
                        <br />
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-sm">
                                <thead class="thead-dark">
                                <thead>
                                    <tr>
                                        <th style="width: 10%;">
                                                @Html.DisplayNameFor(model => model.IdColaborador)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Nombre)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Apellido)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Correo)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Telefono)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Rol)
                                        </th>
                                        <th>
                                                @Html.DisplayNameFor(model => model.Estado)
                                        </th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                        @if (Model != null && Model.Any())
                                        {
                                            @foreach (var item in Model)
                                            {
                                            <tr>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.IdColaborador)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Nombre)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Apellido)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Correo)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Telefono)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Rol)
                                                </td>
                                                <td>
                                                        @Html.DisplayFor(modelItem => item.Estado)
                                                </td>
                                                <td class="acciones">
                                                    <input type="button" value="Detalles" class="btn-pill"
                                                           onclick="location.href='@Url.Action("ActualizarColaborador","Colaborador", new { idColaborador = item.IdColaborador})'">

                                                </td>
                                            </tr>
                                            }
                                        }
                                        else
                                        {
                                        <tr><td colspan="6" class="nodata">No hay datos para mostrar</td></tr>
                                        }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // FILTRO DE BÚSQUEDA EN TIEMPO REAL
            $("#search").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#table-body tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}